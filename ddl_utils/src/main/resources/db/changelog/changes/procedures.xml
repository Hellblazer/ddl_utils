<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.22.xsd">

    <!-- One changeset per stored procedure, mirroring functions.xml. Each
         procedure lives in its own file under procedures/<schema>/ and is added
         with createProcedure (Liquibase has no createFunction/createProcedure
         distinction beyond the change type). Each routine carries its own
         rollback under procedures-rollback/<schema>/.

         The changelog is deployed. Schema changesets are frozen, but these
         routine changesets use runOnChange: edit the procedure file and its
         paired rollback in place, keep the changeset id/path/attributes fixed,
         and the changed body is re-applied on upgrade. Do not add versioned
         files or rename a routine to change it. CREATE OR REPLACE only replaces
         an identical signature; when the signature changes, add
         `DROP PROCEDURE IF EXISTS <old signature>;` before the new
         CREATE OR REPLACE, update the rollback, and add or update the grant in a
         new grant changeset. RoutineSignatureTest fails the build if a routine
         name ends up with more than one signature unless the overload is
         explicitly allow-listed.

         A procedure commits between its ALTER TABLE steps, so a CALL must run
         in autocommit (inside a client transaction block PostgreSQL raises
         "invalid transaction termination"); see procedures/README.md. The
         changesets below only issue CREATE OR REPLACE PROCEDURE, whose embedded
         COMMITs are body text, so they do not need runInTransaction="false". -->
    <changeSet id="procedure-ddl_utils.ensure_not_null" author="lee.horner" dbms="postgresql" runOnChange="true">
        <createProcedure path="procedures/ddl_utils/ensure_not_null.sql" relativeToChangelogFile="true"/>
        <rollback>
            <sqlFile path="procedures-rollback/ddl_utils/ensure_not_null-rollback.sql"
                     relativeToChangelogFile="true"/>
        </rollback>
    </changeSet>

    <changeSet id="procedure-ddl_utils.ensure_check_constraint" author="lee.horner" dbms="postgresql"
               runOnChange="true">
        <createProcedure path="procedures/ddl_utils/ensure_check_constraint.sql" relativeToChangelogFile="true"/>
        <rollback>
            <sqlFile path="procedures-rollback/ddl_utils/ensure_check_constraint-rollback.sql"
                     relativeToChangelogFile="true"/>
        </rollback>
    </changeSet>

    <changeSet id="procedure-ddl_utils.ensure_foreign_key" author="lee.horner" dbms="postgresql" runOnChange="true">
        <createProcedure path="procedures/ddl_utils/ensure_foreign_key.sql" relativeToChangelogFile="true"/>
        <rollback>
            <sqlFile path="procedures-rollback/ddl_utils/ensure_foreign_key-rollback.sql"
                     relativeToChangelogFile="true"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
