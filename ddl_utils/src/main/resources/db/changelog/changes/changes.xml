<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.22.xsd">

    <!-- The changelog is deployed. Released schema changesets are frozen: do not
         edit their id, SQL, rollback or attributes; add a new changeset for
         schema work. Routine, procedure and trigger changesets use runOnChange
         and their object files are edited in place. -->

    <!-- Fail fast, before any DDL, when the documented role setup was skipped:
         every grant below assumes ddl_utils_caller exists, and without this
         check the failure would come from the last changeset after every object
         had already been created. A sqlCheck is the one place a tiny inline SQL
         statement is accepted (the changelog otherwise keeps SQL in files). The
         second check covers the migration (owner) role's README prerequisite;
         ALTER DEFAULT PRIVILEGES in 999 makes the migration role the one whose
         future routines need no PUBLIC EXECUTE. -->
    <changeSet id="001-create-schema" author="lee.horner" dbms="postgresql">
        <preConditions onFail="HALT" onError="HALT">
            <sqlCheck expectedResult="ok">
                SELECT CASE
                           WHEN pg_catalog.to_regrole('ddl_utils_caller') IS NOT NULL THEN 'ok'
                           ELSE 'the ddl_utils_caller role is missing: create the roles before running the changelog (README "Installing with the Liquibase CLI", step 1 "Create the roles")'
                           END
            </sqlCheck>
            <sqlCheck expectedResult="ok">
                SELECT CASE
                           WHEN pg_catalog.has_database_privilege(current_user, current_database(),
                                                                  'CREATE') THEN 'ok'
                           ELSE 'the migration role lacks CREATE on this database: grant it as shown in README "Installing with the Liquibase CLI", step 1 "Create the roles"'
                           END
            </sqlCheck>
        </preConditions>
        <sqlFile path="sql_changes/001-create-schema.sql" relativeToChangelogFile="true"/>
        <rollback>
            <sqlFile path="rollback/001-create-schema-rollback.sql" relativeToChangelogFile="true"/>
        </rollback>
    </changeSet>

    <changeSet id="002-create-lib-schema" author="lee.horner" dbms="postgresql">
        <sqlFile path="sql_changes/002-create-lib-schema.sql" relativeToChangelogFile="true"/>
        <rollback>
            <sqlFile path="rollback/002-create-lib-schema-rollback.sql" relativeToChangelogFile="true"/>
        </rollback>
    </changeSet>

    <changeSet id="003-create-lock-settings" author="lee.horner" dbms="postgresql">
        <sqlFile path="sql_changes/003-create-lock-settings.sql" relativeToChangelogFile="true"/>
        <rollback>
            <sqlFile path="rollback/003-create-lock-settings-rollback.sql" relativeToChangelogFile="true"/>
        </rollback>
    </changeSet>

    <changeSet id="004-create-domains" author="lee.horner" dbms="postgresql">
        <sqlFile path="sql_changes/004-create-domains.sql" relativeToChangelogFile="true"/>
        <rollback>
            <sqlFile path="rollback/004-create-domains-rollback.sql" relativeToChangelogFile="true"/>
        </rollback>
    </changeSet>

    <!-- The composite the lock-aware wrappers read get_lock_settings into; it
         must exist before the routines that declare a variable of it, so it is
         created here rather than after the routine includes. -->
    <changeSet id="005-create-lock-settings-type" author="lee.horner" dbms="postgresql">
        <sqlFile path="sql_changes/005-create-lock-settings-type.sql" relativeToChangelogFile="true"/>
        <rollback>
            <sqlFile path="rollback/005-create-lock-settings-type-rollback.sql" relativeToChangelogFile="true"/>
        </rollback>
    </changeSet>

    <!-- Stored routines: one changeset each, one file per routine. -->
    <include file="functions.xml" relativeToChangelogFile="true"/>
    <include file="procedures.xml" relativeToChangelogFile="true"/>

    <!-- The tables' triggers, one per file. They call routines defined above,
         so they run after the functions include. New tables created by later
         changesets must attach the same trigger. -->
    <include file="triggers.xml" relativeToChangelogFile="true"/>

    <!-- The caller grants for the released changesets. This changeset is frozen:
         do not edit it. New routines need a new grant changeset (with its own
         rollback) added after their object-creating changeset; the new
         changeset must keep the same add-only/REVOKE discipline.

         For the initial install this file is add-only: a GRANT removed from it
         is not reverted, so removal must always be an explicit REVOKE. Keep the
         statements idempotent. Keep this changeset physically after every
         object-creating include (functions.xml, procedures.xml, triggers.xml):
         Liquibase orders by file position, not by the "999" id, so otherwise a
         newly created routine keeps PostgreSQL's default EXECUTE TO PUBLIC.
         The SQL file must stay free of dollar-quoted blocks because the default
         sqlFile splitter is not dollar-quote aware. -->
    <changeSet id="999-grant-privileges" author="lee.horner" dbms="postgresql" runOnChange="true">
        <sqlFile path="sql_changes/999-grant-privileges.sql" relativeToChangelogFile="true"/>
        <rollback>
            <sqlFile path="rollback/999-grant-privileges-rollback.sql" relativeToChangelogFile="true"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
